{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-world-system.local/schemas/v1/product-record.schema.json",
  "title": "Product record",
  "description": "A governed product record synthesized from product-specific sources. Stored alongside the Brand Brain, versioned independently. See ADR 0012.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "version",
    "product_name",
    "category",
    "one_true_thing",
    "audience_note",
    "features",
    "proof_points",
    "visual_direction",
    "exclusions",
    "review_questions",
    "source_summary",
    "provenance"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "product_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "product_name": { "$ref": "common.schema.json#/$defs/non_empty_string" },
    "category": { "$ref": "common.schema.json#/$defs/non_empty_string" },
    "one_true_thing": { "$ref": "common.schema.json#/$defs/non_empty_string" },
    "audience_note": { "$ref": "common.schema.json#/$defs/non_empty_string" },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/feature" }
    },
    "proof_points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "common.schema.json#/$defs/non_empty_string" }
    },
    "visual_direction": { "$ref": "common.schema.json#/$defs/non_empty_string" },
    "exclusions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": { "$ref": "common.schema.json#/$defs/non_empty_string" }
    },
    "review_questions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/review_question" }
    },
    "source_summary": { "$ref": "common.schema.json#/$defs/non_empty_string" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "$defs": {
    "feature_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "location"],
      "properties": {
        "quote": { "$ref": "common.schema.json#/$defs/non_empty_string" },
        "location": { "$ref": "common.schema.json#/$defs/non_empty_string" }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "benefit", "approved_claim_language", "accuracy_note", "origin", "evidence"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/non_empty_string" },
        "benefit": { "$ref": "common.schema.json#/$defs/non_empty_string" },
        "approved_claim_language": {
          "type": "string",
          "description": "Verbatim wording from the source. Empty string when the source does not supply claim language."
        },
        "accuracy_note": {
          "type": "string",
          "description": "Accuracy or labeling constraint such as conditional availability. Empty string when none applies."
        },
        "origin": { "enum": ["stated", "inferred"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/feature_evidence" }
        }
      }
    },
    "review_question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "evidence_quote", "confidence"],
      "properties": {
        "title": { "$ref": "common.schema.json#/$defs/non_empty_string" },
        "summary": { "$ref": "common.schema.json#/$defs/non_empty_string" },
        "evidence_quote": {
          "type": "string",
          "description": "Verbatim quote from the source that prompted the question. Empty string when no single quote applies."
        },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    }
  }
}
